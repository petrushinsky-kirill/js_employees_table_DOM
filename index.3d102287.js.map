"use strict";
var tableBody = document.querySelector("tbody");
var tableHeadRow = document.querySelector("thead tr");
var form = document.createElement("form");
// ---------------Sorting function---------------------------
var sortDirections = {};
tableHeadRow.addEventListener("click", function(e) {
    var target = e.target;
    while(target && target.nodeName !== "TH")target = target.parentElement;
    if (!target) return;
    var headers = Array.from(tableHeadRow.children);
    var index = headers.indexOf(target);
    var bodyArr = Array.from(tableBody.children);
    var ascending = !sortDirections[index];
    sortDirections[index] = ascending;
    bodyArr.sort(function(row1, row2) {
        var cell1 = row1.children[index];
        var cell2 = row2.children[index];
        var text1 = cell1.textContent.replace(/[$,]/g, "");
        var text2 = cell2.textContent.replace(/[$,]/g, "");
        var value1 = isNaN(text1) ? text1 : parseFloat(text1);
        var value2 = isNaN(text2) ? text2 : parseFloat(text2);
        if (typeof value1 === "number" && typeof value2 === "number") return ascending ? value1 - value2 : value2 - value1;
        else return ascending ? value1.localeCompare(value2) : value2.localeCompare(value1);
    });
    bodyArr.forEach(function(row) {
        return tableBody.appendChild(row);
    });
});
// -------------------------------------------------------------
// ------------------Selecting function-----------------------------
tableBody.addEventListener("click", function(e) {
    var clickedRow = e.target.closest("tr");
    Array.from(tableBody.children).forEach(function(row) {
        row.classList.remove("active");
    });
    clickedRow.classList.add("active");
});
// --------------------Form adding-----------------------------
var createForm = function() {
    form.classList.add("new-employee-form");
    var labelNames = [
        "name",
        "position",
        "office",
        "age",
        "salary"
    ];
    var selectFieldName = "office";
    var selectOptions = [
        "Tokyo",
        "Singapore",
        "London",
        "New York",
        "Edinburgh",
        "San Francisco"
    ];
    form.noValidate = true;
    // ---Add labels---
    labelNames.forEach(function(labelName) {
        var label = document.createElement("label");
        label.textContent = labelName.charAt(0).toUpperCase() + labelName.slice(1) + ":";
        // ---Add input fields---
        if (labelName === selectFieldName) {
            var inputField = document.createElement("select");
            inputField.name = labelName;
            inputField.setAttribute("data-qa", labelName);
            inputField.required = true;
            selectOptions.forEach(function(selectOption) {
                var option = document.createElement("option");
                option.textContent = selectOption;
                option.value = selectOption;
                inputField.appendChild(option);
            });
            label.appendChild(inputField);
        } else {
            var inputField1 = document.createElement("input");
            inputField1.type = "text";
            inputField1.name = labelName;
            inputField1.setAttribute("data-qa", labelName);
            inputField1.required = true;
            inputField1.placeholder = "Your ".concat(labelName);
            label.appendChild(inputField1);
        }
        // --------------------
        form.appendChild(label);
    });
    // --- Add button ---
    var submitButton = document.createElement("button");
    submitButton.classList.add("button");
    submitButton.innerText = "Save to table";
    submitButton.type = "submit";
    form.appendChild(submitButton);
    document.body.append(form);
};
createForm();
// ------------------------------------------------------------
// ----------------Form submiting---------------------------
form.addEventListener("submit", submitFunction);
function submitFunction(e) {
    e.preventDefault();
    var target = e.target;
    // ----- Creating new row---------
    var newTableRow = document.createElement("tr");
    var parentForm = target.closest("form");
    var formElements = parentForm.elements;
    var hasError = false;
    Array.from(formElements).forEach(function(element) {
        if (element.tagName === "BUTTON") return;
        var value = element.value.trim();
        // -------Check empty field---------
        if (!value) {
            showNotification("error", "All fields are required");
            hasError = true;
        }
        // -------Check if age and salary fields are numeric---------
        if ([
            "age",
            "salary"
        ].includes(element.name)) {
            if (isNaN(Number(value))) {
                showNotification("error", "".concat(element.name, " must be a number"));
                hasError = true;
            }
        }
        // -------Check if age is from 18 to 90--------
        if (element.name === "age") {
            var age = Number(element.value);
            if (age < 18 || age > 90) {
                showNotification("error", "Age must be from 18 to 90");
                hasError = true;
            }
        }
        // -------Check if name is longer than 4--------
        if (element.name === "name") {
            if (element.value.trim().length < 4) {
                showNotification("error", "Name must have more than 4 letters");
                hasError = true;
            }
        }
        var fieldValue = element.value;
        var newCell = document.createElement("td");
        if (element.name === "salary") {
            var formattedSal = new Intl.NumberFormat("en-US").format(element.value);
            newCell.innerText = "$".concat(formattedSal);
        } else newCell.innerText = fieldValue;
        newTableRow.appendChild(newCell);
    });
    if (hasError) return;
    showNotification("success", "Employee added.");
    tableBody.appendChild(newTableRow);
}
// ------------------------------------------------------------
// --------------Create notification-------------------------
function showNotification(type, message) {
    document.querySelectorAll(".notification").forEach(function(n) {
        return n.remove();
    });
    var notificationBody = document.createElement("div");
    var notificationTitle = document.createElement("p");
    notificationTitle.className = "title";
    notificationBody.setAttribute("data-qa", "notification");
    notificationBody.className = "notification ".concat(type);
    notificationBody.append(notificationTitle);
    notificationTitle.innerText = message;
    document.body.appendChild(notificationBody);
    setTimeout(function() {
        return notificationBody.remove();
    }, 15000);
}

